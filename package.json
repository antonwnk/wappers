  },
  "dependencies": {
    "@hono/node-server": "^2.0.1",
    "baileys": "7.0.0-rc.9",
    "better-sqlite3": "^12.9.0",
    "hono": "^4.12.16",
    "pino": "^10.3.1",
    "qrcode-terminal": "^0.12.0",
    "yaml": "^2.8.4",
